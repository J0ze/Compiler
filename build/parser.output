Grammar

    0 $accept: Script $end

    1 Script: statement_list_opt

    2 statement_list_opt: /* empty */
    3                   | statement_list

    4 statement_list: statement
    5               | statement_list statement

    6 statement: block_statement
    7          | variable_statement
    8          | if_statement
    9          | return_statement
   10          | expression_statement
   11          | function_declaration
   12          | iteration_statement
   13          | break_statement
   14          | continue_statement
   15          | switch_statement
   16          | try_statement
   17          | throw_statement
   18          | class_declaration
   19          | empty_statement

   20 empty_statement: StatementTerminator

   21 block_statement: LBRACE statement_list_opt RBRACE

   22 StatementTerminator: SEMICOLON
   23                    | TOK_VIRTUAL_SEMICOLON

   24 variable_statement: variable_declaration_list StatementTerminator

   25 variable_declaration_list: LET variable_declaration_list_inner
   26                          | CONST variable_declaration_list_inner
   27                          | VAR variable_declaration_list_inner

   28 variable_declaration_list_inner: variable_declaration
   29                                | variable_declaration_list_inner COMMA variable_declaration

   30 variable_declaration: IDENTIFIER
   31                     | IDENTIFIER ASSIGN assignment_expression

   32 if_statement: IF LPAREN expression RPAREN statement
   33             | IF LPAREN expression RPAREN statement ELSE statement

   34 expression_statement: expression StatementTerminator

   35 expression_opt: /* empty */
   36               | expression

   37 @1: /* empty */

   38 return_statement: RETURN @1 expression_opt StatementTerminator

   39 function_declaration: FUNCTION IDENTIFIER arguments block_statement

   40 iteration_statement: while_statement
   41                    | for_statement
   42                    | do_while_statement

   43 while_statement: WHILE LPAREN expression RPAREN statement

   44 for_statement: FOR LPAREN for_init SEMICOLON expression_opt SEMICOLON expression_opt RPAREN statement

   45 for_init: /* empty */
   46         | variable_declaration_list
   47         | expression

   48 do_while_statement: DO statement WHILE LPAREN expression RPAREN StatementTerminator

   49 break_statement: BREAK StatementTerminator

   50 continue_statement: CONTINUE StatementTerminator

   51 switch_statement: SWITCH LPAREN expression RPAREN LBRACE switch_case_list RBRACE

   52 try_statement: TRY block_statement catch_clause
   53              | TRY block_statement finally_clause
   54              | TRY block_statement catch_clause finally_clause

   55 catch_clause: CATCH LPAREN IDENTIFIER RPAREN block_statement

   56 finally_clause: FINALLY block_statement

   57 @2: /* empty */

   58 throw_statement: THROW @2 expression StatementTerminator

   59 switch_case_list: /* empty */
   60                 | switch_case_list switch_case

   61 switch_case: CASE expression COLON case_statement_list
   62            | DEFAULT COLON case_statement_list

   63 case_statement_list: /* empty */
   64                    | case_statement_list statement

   65 arrow_parameter_list: /* empty */
   66                     | identifier_list

   67 identifier_list: IDENTIFIER
   68                | identifier_list COMMA IDENTIFIER

   69 function_expression: FUNCTION arguments block_statement
   70                    | FUNCTION IDENTIFIER arguments block_statement

   71 class_declaration: CLASS IDENTIFIER class_body
   72                  | CLASS IDENTIFIER EXTENDS assignment_expression class_body

   73 class_body: LBRACE method_definition_list RBRACE

   74 method_definition_list: /* empty */
   75                       | method_definition_list method_definition

   76 method_definition: property_name arguments block_statement
   77                  | STATIC property_name arguments block_statement

   78 expression: assignment_expression
   79           | expression COMMA assignment_expression

   80 assignment_expression: conditional_expression
   81                      | arrow_function_expression
   82                      | left_hand_side_expression ASSIGN assignment_expression
   83                      | left_hand_side_expression ADD_ASSIGN assignment_expression
   84                      | left_hand_side_expression SUB_ASSIGN assignment_expression

   85 conditional_expression: logical_or_expression
   86                       | logical_or_expression CONDITIONAL assignment_expression COLON assignment_expression

   87 logical_or_expression: logical_and_expression
   88                      | logical_or_expression LOGICAL_OR logical_and_expression

   89 logical_and_expression: bitwise_or_expression
   90                       | logical_and_expression LOGICAL_AND bitwise_or_expression

   91 bitwise_or_expression: bitwise_xor_expression
   92                      | bitwise_or_expression BIT_OR bitwise_xor_expression

   93 bitwise_xor_expression: bitwise_and_expression
   94                       | bitwise_xor_expression BIT_XOR bitwise_and_expression

   95 bitwise_and_expression: equality_expression
   96                       | bitwise_and_expression BIT_AND equality_expression

   97 equality_expression: relational_expression
   98                    | equality_expression EQ relational_expression
   99                    | equality_expression NE relational_expression
  100                    | equality_expression STRICT_EQ relational_expression
  101                    | equality_expression STRICT_NE relational_expression

  102 relational_expression: shift_expression
  103                      | relational_expression LT shift_expression
  104                      | relational_expression GT shift_expression
  105                      | relational_expression LE shift_expression
  106                      | relational_expression GE shift_expression
  107                      | relational_expression IN shift_expression
  108                      | relational_expression INSTANCEOF shift_expression

  109 shift_expression: additive_expression
  110                 | shift_expression LSHIFT additive_expression
  111                 | shift_expression RSHIFT additive_expression
  112                 | shift_expression URSHIFT additive_expression

  113 additive_expression: multiplicative_expression
  114                    | additive_expression PLUS multiplicative_expression
  115                    | additive_expression MINUS multiplicative_expression

  116 multiplicative_expression: unary_expression
  117                          | multiplicative_expression MUL unary_expression
  118                          | multiplicative_expression MOD unary_expression
  119                          | multiplicative_expression POWER unary_expression

  120 unary_expression: update_expression
  121                 | DELETE unary_expression
  122                 | VOID unary_expression
  123                 | TYPEOF unary_expression
  124                 | INC unary_expression
  125                 | DEC unary_expression
  126                 | PLUS unary_expression
  127                 | MINUS unary_expression
  128                 | BIT_NOT unary_expression
  129                 | NOT unary_expression

  130 update_expression: left_hand_side_expression
  131                  | left_hand_side_expression INC
  132                  | left_hand_side_expression DEC

  133 left_hand_side_expression: new_expression
  134                          | call_expression

  135 new_expression: member_expression
  136               | NEW new_expression

  137 call_expression: member_expression arguments
  138                | NEW new_expression arguments

  139 member_expression: primary_expression
  140                  | member_expression LBRACK expression RBRACK
  141                  | member_expression DOT IDENTIFIER

  142 arguments: LPAREN RPAREN
  143          | LPAREN argument_list RPAREN

  144 argument_list: assignment_expression
  145              | argument_list COMMA assignment_expression

  146 literal_or_identifier: IDENTIFIER
  147                      | NUMERIC_LITERAL
  148                      | STRING_LITERAL

  149 primary_expression: THIS
  150                   | literal_or_identifier
  151                   | TRUE_LITERAL
  152                   | FALSE_LITERAL
  153                   | NULL_LITERAL
  154                   | LPAREN expression RPAREN
  155                   | object_expression
  156                   | array_expression
  157                   | function_expression
  158                   | SUPER

  159 object_expression: LBRACE RBRACE
  160                  | LBRACE property_list RBRACE

  161 property_list: property
  162              | property_list COMMA property

  163 property: property_name COLON assignment_expression

  164 property_name: literal_or_identifier

  165 array_expression: LBRACK RBRACK
  166                 | LBRACK element_list RBRACK

  167 element_list: assignment_expression
  168             | element_list COMMA assignment_expression

  169 arrow_function_expression: LPAREN arrow_parameter_list RPAREN ARROW arrow_body
  170                          | IDENTIFIER ARROW arrow_body

  171 arrow_body: block_statement
  172           | logical_or_expression


