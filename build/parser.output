Grammar

    0 $accept: Script $end

    1 Script: statement_list_opt

    2 statement_list_opt: /* empty */
    3                   | statement_list

    4 statement_list: statement
    5               | statement_list statement

    6 statement: block_statement
    7          | variable_statement
    8          | if_statement
    9          | return_statement
   10          | expression_statement
   11          | function_declaration
   12          | iteration_statement
   13          | break_statement
   14          | continue_statement
   15          | switch_statement
   16          | try_statement
   17          | throw_statement
   18          | class_declaration
   19          | empty_statement

   20 empty_statement: StatementTerminator

   21 block_statement: LBRACE statement_list_opt RBRACE

   22 StatementTerminator: SEMICOLON
   23                    | TOK_VIRTUAL_SEMICOLON

   24 variable_statement: variable_declaration_list StatementTerminator

   25 variable_declaration_list: LET variable_declaration_list_inner
   26                          | CONST variable_declaration_list_inner
   27                          | VAR variable_declaration_list_inner

   28 variable_declaration_list_inner: variable_declaration
   29                                | variable_declaration_list_inner COMMA variable_declaration

   30 variable_declaration: IDENTIFIER
   31                     | IDENTIFIER ASSIGN assignment_expression

   32 if_statement: IF LPAREN expression RPAREN statement
   33             | IF LPAREN expression RPAREN statement ELSE statement

   34 expression_statement: expression StatementTerminator

   35 expression_opt: /* empty */
   36               | expression

   37 @1: /* empty */

   38 return_statement: RETURN @1 expression_opt StatementTerminator

   39 function_declaration: FUNCTION IDENTIFIER arguments block_statement

   40 iteration_statement: while_statement
   41                    | for_statement
   42                    | do_while_statement

   43 while_statement: WHILE LPAREN expression RPAREN statement

   44 for_statement: FOR LPAREN for_init SEMICOLON expression_opt SEMICOLON expression_opt RPAREN statement

   45 for_init: /* empty */
   46         | variable_declaration_list
   47         | expression

   48 do_while_statement: DO statement WHILE LPAREN expression RPAREN StatementTerminator

   49 break_statement: BREAK StatementTerminator

   50 continue_statement: CONTINUE StatementTerminator

   51 switch_statement: SWITCH LPAREN expression RPAREN LBRACE switch_case_list RBRACE

   52 try_statement: TRY block_statement catch_clause
   53              | TRY block_statement finally_clause
   54              | TRY block_statement catch_clause finally_clause

   55 catch_clause: CATCH LPAREN IDENTIFIER RPAREN block_statement

   56 finally_clause: FINALLY block_statement

   57 @2: /* empty */

   58 throw_statement: THROW @2 expression StatementTerminator

   59 switch_case_list: /* empty */
   60                 | switch_case_list switch_case

   61 switch_case: CASE expression COLON case_statement_list
   62            | DEFAULT COLON case_statement_list

   63 case_statement_list: /* empty */
   64                    | case_statement_list statement

   65 literal_or_identifier: IDENTIFIER
   66                      | NUMERIC_LITERAL
   67                      | STRING_LITERAL

   68 arrow_parameter_list: /* empty */
   69                     | identifier_list

   70 identifier_list: IDENTIFIER
   71                | identifier_list COMMA IDENTIFIER

   72 function_expression: FUNCTION arguments block_statement

   73 class_declaration: CLASS IDENTIFIER class_body
   74                  | CLASS IDENTIFIER EXTENDS assignment_expression class_body

   75 class_body: LBRACE method_definition_list RBRACE

   76 method_definition_list: /* empty */
   77                       | method_definition_list method_definition

   78 method_definition: property_name arguments block_statement
   79                  | STATIC property_name arguments block_statement

   80 expression: assignment_expression
   81           | expression COMMA assignment_expression

   82 assignment_expression: conditional_expression
   83                      | arrow_function_expression
   84                      | left_hand_side_expression ASSIGN assignment_expression
   85                      | left_hand_side_expression ADD_ASSIGN assignment_expression
   86                      | left_hand_side_expression SUB_ASSIGN assignment_expression

   87 conditional_expression: logical_or_expression
   88                       | logical_or_expression CONDITIONAL assignment_expression COLON assignment_expression

   89 logical_or_expression: logical_and_expression
   90                      | logical_or_expression LOGICAL_OR logical_and_expression

   91 logical_and_expression: bitwise_or_expression
   92                       | logical_and_expression LOGICAL_AND bitwise_or_expression

   93 bitwise_or_expression: bitwise_xor_expression
   94                      | bitwise_or_expression BIT_OR bitwise_xor_expression

   95 bitwise_xor_expression: bitwise_and_expression
   96                       | bitwise_xor_expression BIT_XOR bitwise_and_expression

   97 bitwise_and_expression: equality_expression
   98                       | bitwise_and_expression BIT_AND equality_expression

   99 equality_expression: relational_expression
  100                    | equality_expression EQ relational_expression
  101                    | equality_expression NE relational_expression
  102                    | equality_expression STRICT_EQ relational_expression
  103                    | equality_expression STRICT_NE relational_expression

  104 relational_expression: shift_expression
  105                      | relational_expression LT shift_expression
  106                      | relational_expression GT shift_expression
  107                      | relational_expression LE shift_expression
  108                      | relational_expression GE shift_expression
  109                      | relational_expression IN shift_expression
  110                      | relational_expression INSTANCEOF shift_expression

  111 shift_expression: additive_expression
  112                 | shift_expression LSHIFT additive_expression
  113                 | shift_expression RSHIFT additive_expression
  114                 | shift_expression URSHIFT additive_expression

  115 additive_expression: multiplicative_expression
  116                    | additive_expression PLUS multiplicative_expression
  117                    | additive_expression MINUS multiplicative_expression

  118 multiplicative_expression: unary_expression
  119                          | multiplicative_expression MUL unary_expression
  120                          | multiplicative_expression MOD unary_expression
  121                          | multiplicative_expression POWER unary_expression

  122 unary_expression: update_expression
  123                 | DELETE unary_expression
  124                 | VOID unary_expression
  125                 | TYPEOF unary_expression
  126                 | INC unary_expression
  127                 | DEC unary_expression
  128                 | PLUS unary_expression
  129                 | MINUS unary_expression
  130                 | BIT_NOT unary_expression
  131                 | NOT unary_expression

  132 update_expression: left_hand_side_expression
  133                  | left_hand_side_expression INC
  134                  | left_hand_side_expression DEC

  135 left_hand_side_expression: new_expression
  136                          | call_expression

  137 new_expression: member_expression
  138               | NEW new_expression

  139 call_expression: member_expression arguments
  140                | NEW new_expression arguments

  141 member_expression: primary_expression
  142                  | member_expression LBRACK expression RBRACK
  143                  | member_expression DOT IDENTIFIER

  144 arguments: LPAREN RPAREN
  145          | LPAREN argument_list RPAREN

  146 argument_list: assignment_expression
  147              | argument_list COMMA assignment_expression

  148 primary_expression: THIS
  149                   | literal_or_identifier
  150                   | TRUE_LITERAL
  151                   | FALSE_LITERAL
  152                   | NULL_LITERAL
  153                   | LPAREN expression RPAREN
  154                   | object_expression
  155                   | array_expression
  156                   | function_expression
  157                   | SUPER

  158 object_expression: LBRACE RBRACE
  159                  | LBRACE property_list RBRACE

  160 property_list: property
  161              | property_list COMMA property

  162 property: property_name COLON assignment_expression

  163 property_name: literal_or_identifier

  164 array_expression: LBRACK RBRACK
  165                 | LBRACK element_list RBRACK

  166 element_list: assignment_expression
  167             | element_list COMMA assignment_expression

  168 arrow_function_expression: LPAREN arrow_parameter_list RPAREN ARROW arrow_body
  169                          | IDENTIFIER ARROW arrow_body

  170 arrow_body: block_statement
  171           | logical_or_expression


